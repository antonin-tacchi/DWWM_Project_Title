# URL de la Gateway — utilisée UNIQUEMENT si tu remplaces baseURL dans api.js
# En développement, Vite proxifie automatiquement vers http://localhost:8080 (voir vite.config.js)
# En production Docker, nginx proxifie vers la gateway sur le port 8080
# => baseURL reste vide ('') dans api.js, ce fichier sert de référence
VITE_API_URL=http://localhost:8080

# Cloudflare Turnstile site key publique
# Cle de test Cloudflare visible qui passe toujours en dev.
# A utiliser avec la secret key de test cote backend et TURNSTILE_EXPECTED_ACTION=test.
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=Your_Turnstile_Site_Key
