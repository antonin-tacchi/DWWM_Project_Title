# URL de la Gateway — utilisée UNIQUEMENT si tu remplaces baseURL dans api.js
# En développement, Vite proxifie automatiquement vers http://localhost:8080 (voir vite.config.js)
# En production Docker, nginx proxifie vers la gateway sur le port 8080
# => baseURL reste vide ('') dans api.js, ce fichier sert de référence
VITE_API_URL=http://localhost:8080
